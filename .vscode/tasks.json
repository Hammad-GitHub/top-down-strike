{
  "version": "2.0.0",
  "tasks": [
    {
      // Debug build: compiles every .cpp in the folder into top-down-strike.exe
      "label": "build top-down-strike (debug)",
      "type": "shell",
      "command": "g++",
      "args": [
        "-g",
        "-O0",
        "-std=c++11",
        "-Wall",
        "main.cpp", "Game.cpp", "Character.cpp", "Player.cpp", "Enemy.cpp",
        "Weapon.cpp", "Bullet.cpp", "Bomb.cpp", "Map.cpp", "ScoreBoard.cpp",
        "-o", "top-down-strike.exe",
        // If raylib is NOT on your compiler's default path, add e.g.:
        // "-IC:/raylib/raylib/src", "-LC:/raylib/raylib/src",
        "-lraylib", "-lopengl32", "-lgdi32", "-lwinmm"
      ],
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$gcc"]
    },
    {
      // Optimized build for the final presentation
      "label": "build top-down-strike (release)",
      "type": "shell",
      "command": "g++",
      "args": [
        "-O2",
        "-std=c++11",
        "main.cpp", "Game.cpp", "Character.cpp", "Player.cpp", "Enemy.cpp",
        "Weapon.cpp", "Bullet.cpp", "Bomb.cpp", "Map.cpp", "ScoreBoard.cpp",
        "-o", "top-down-strike.exe",
        "-lraylib", "-lopengl32", "-lgdi32", "-lwinmm"
      ],
      "options": { "cwd": "${workspaceFolder}" },
      "group": "build",
      "problemMatcher": ["$gcc"]
    }
  ]
}